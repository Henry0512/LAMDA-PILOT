{
    "prefix": " ",
    "dataset": "cifar224",
    "memory_size": 0,
    "memory_per_class": 0,
    "fixed_memory": false,
    "shuffle": false,
    "init_cls": 10,
    "increment": 10,
    "model_name": "coda_prompt",
    "backbone_type": "vit_base_patch16_224_coda_prompt",
    "device": ["0"],
    "seed": [0],
    
    "tuned_epoch": 20,
    "init_lr": 0.001,
    "batch_size": 128,
    "weight_decay": 0,
    "min_lr": 1e-5,
    "optimizer": "adam",
    "scheduler": "cosine",
    "reinit_optimizer": true,

    "pretrained": true,
    "drop": 0.0,
    "drop_path": 0.0,

    "prompt_param": [100, 8.0, 0.0],

    "reweighting": {
        "enabled": true,
        "buffer_size": 2048,
        "feature_dim": 768,
        "inner_epochs": 3,
        "bootstrap_iters": 15,
        "lr": 0.08,
        "momentum": 0.9,
        "lambda_coef": 80.0,
        "lambda_decay_rate": 0.9,
        "lambda_decay_epoch": 4,
        "min_lambda": 0.05,
        "presave_ratio": 0.85,
        "decay_pow": 2.0,
        "num_fourier": 2,
        "use_sum": true,
        "first_step_cons": 0.3,
        "warmup_epochs": 3,
        "start_task": 0,
        "norm": "softplus",
        "clamp_ratio": 1.8,
        "min_clamp_ratio": 1.1,
        "temperature": 0.8,
        "task_lr_decay": 0.92,
        "task_lambda_scale": 1.05,
        "reg_weight": 0.03,
        "reg_task_decay": 0.85,
        "prompt_loss_weight": 1.0,
        "loss_aware_init": true,
        "loss_init_scale": 0.15
    }
}